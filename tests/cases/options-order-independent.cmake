# The order OPTIONS are written in is not part of a declaration's identity, so
# these two declarations are compatible.
declare_default_native_dependency(
  demodep
  MODE source_url
  SOURCE_URL "${ND_DEP_ARCHIVE}"
  SOURCE_HASH "${ND_DEP_HASH}"
  OPTIONS DEMO_OPT=ON DEMO_OTHER=ON
)
